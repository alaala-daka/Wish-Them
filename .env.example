# 本地开发用环境变量样例：复制为 .env 后填值（.env 不入库）。
# 线上不读本文件：这些值来自 Qoder Sites 的 Function Secrets（Deno.env），见 docs/05-environment.md。
# 缺任意一项必填密钥，Function 会以 code=503 / errorCode=service_not_configured 起服务，而不是静默用默认密钥。

# ── 必填密钥（都是 >=32 字符随机串；生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"）
JWT_SIGNING_KEY=
TOKEN_PEPPER=
RECOVERY_PEPPER=
IP_HASH_SALT=
IDEM_FINGERPRINT_KEY=
# 五问答案字段级加密（AES-256-GCM，实际密钥 = SHA-256(本值)，AAD = wish_id）。
# 第 3 轮起必填：PUT /api/wishes/:id/answers 靠它落密文。换值 = 全量重加密，上线前定稿。
FIELD_ENCRYPTION_KEY=

# ── 可选：不填走代码内默认值
# JWT 有效期（天），默认 30，PRD A-02 要求 30 天
TOKEN_TTL_DAYS=30
# 同一 IP 每小时游客注册上限，默认 10（限流是兜底，IP 可被伪造，见 docs/05 §4）
GUEST_PER_HOUR=10
# 同一 IP 每小时恢复码尝试上限，默认 12
RECOVER_PER_HOUR=12
# 演示会话：单 IP 每小时上限（默认 30）、有效期小时数（默认 24）
DEMO_PER_HOUR=30
DEMO_TTL_HOURS=24
# 账号级窗口阈值：默认值见 lib/config.ts；注意窗口计数单次最多扫 50 行（quota.ts#SCAN_LIMIT），
# 配置超过 50 会被回落到默认值，不能靠调大绕过计数上限。
WISH_CREATE_PER_DAY=20
CHECKIN_PER_MINUTE=10
UPLOAD_PER_HOUR=30
POOL_PUBLISH_PER_DAY=5
POOL_REPORT_PER_HOUR=20
POOL_REPORT_HIDE_THRESHOLD=3
REPLY_PER_DAY=20
# AI 润色：每日额度 / 超时毫秒 / 缓存小时；端点留空则只走模板、不发起外部请求
AI_POLISH_PER_DAY=20
AI_TIMEOUT_MS=8000
AI_CACHE_TTL_HOURS=72
AI_AGENT_ENDPOINT=
AI_AGENT_TOKEN=
# DeepSeek 彩蛋：只在服务端调用；密钥为空时自动使用预设文案，评委演示不依赖它
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_EASTER_EGG_ENABLED=1
AI_EASTER_EGG_TIMEOUT_MS=7000
# 服务层兜底限流（实例内存，不查库），默认 1200/分钟
API_PER_MINUTE=1200
# 允许的跨域来源，逗号分隔；小程序与 H5 同源部署时留空即不发 CORS 头
CORS_ALLOW_ORIGINS=

# 部署后首个请求是否幂等补给三张模板表（72/120/24）；默认 1（表空时自动补齐，行数已齐则不写）
# 平台批量写工具不可用时如需关闭可显式设为 0
SEED_ON_START=1

# ── 本地服务器端口（tools/local/serve.ts 用）
PORT=8787
